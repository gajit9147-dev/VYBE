{
  "info": {
    "_postman_id": "9a38f712-4c28-4b71-bc01-vybe-auth-api",
    "name": "VYBE API - Auth Foundation (Step 11)",
    "description": "Production authentication endpoints for VYBE (Registration, Login, Session Cookie, /me, Logout, and Logout All).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "StrongPassword123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user, hashes password with Argon2id, creates session, and returns HttpOnly cookie."
          },
          "response": []
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verifies credentials, resets failed attempt counter, issues new server-side session, and sets HttpOnly cookie."
          },
          "response": []
        },
        {
          "name": "3. Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Returns authenticated user data using the session cookie automatically stored by Postman."
          },
          "response": []
        },
        {
          "name": "4. Logout (Current Session)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes current session in the database and clears the session cookie."
          },
          "response": []
        },
        {
          "name": "5. Logout All Sessions",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout-all"]
            },
            "description": "Invalidates all active sessions belonging to the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Email Verification",
      "item": [
        {
          "name": "1. Send Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-verification/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-verification", "send"]
            },
            "description": "Generates 32-byte secure token hash, enforces 60s cooldown and IP rate limiting, and dispatches verification email."
          },
          "response": []
        },
        {
          "name": "2. Verify Email Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-verification/verify?token=SAMPLE_TOKEN_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-verification", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "SAMPLE_TOKEN_HERE"
                }
              ]
            },
            "description": "Validates single-use token hash and marks account as email-verified."
          },
          "response": []
        },
        {
          "name": "3. Get Verification Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-verification/status?email={{testEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-verification", "status"],
              "query": [
                {
                  "key": "email",
                  "value": "{{testEmail}}"
                }
              ]
            },
            "description": "Retrieves the verification status (isVerified, verifiedAt) for an account."
          },
          "response": []
        }
      ]
    }
  ]
}
