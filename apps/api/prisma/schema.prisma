// Module 22: Moderation Cases & Actions
// -----------------------------------------------------------------------------

enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ModerationActionType {
  WARNING
  PHOTO_REMOVAL
  SHADOWBAN
  SUSPENSION
  PERMANENT_BAN
  DEVICE_BAN
}

enum AppealStatus {
  PENDING_APPEAL
  APPEAL_REJECTED
  OVERTURNED
}

model ModerationCase {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId            String?              @unique @map("report_id") @db.Uuid
  targetUserId        String               @map("target_user_id") @db.Uuid
  severity            ModerationSeverity   @default(MEDIUM)
  status              ModerationCaseStatus @default(OPEN)
  assignedModeratorId String?              @map("assigned_moderator_id") @db.Uuid
  investigationNotes  String?              @map("investigation_notes") @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  report            UserReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  targetUser        User               @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  assignedModerator AdminUser?         @relation(fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  actions           ModerationAction[]

  @@index([status, severity, createdAt])
  @@index([targetUserId])
  @@map("moderation_cases")
}

model ModerationAction {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId                String?              @map("case_id") @db.Uuid
  targetUserId          String               @map("target_user_id") @db.Uuid
  actionType            ModerationActionType @map("action_type")
  reasonCode            String               @map("reason_code") @db.VarChar(48)
  internalJustification String               @map("internal_justification") @db.Text
  expiresAt             DateTime?            @map("expires_at") @db.Timestamptz(6)
  performedByAdminId    String               @map("performed_by_admin_id") @db.Uuid
  appealStatus          AppealStatus?        @map("appeal_status")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  case        ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  targetUser  User            @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  performedBy AdminUser       @relation(fields: [performedByAdminId], references: [id], onDelete: Restrict)

  @@index([targetUserId, actionType, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

