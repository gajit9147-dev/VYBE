// -----------------------------------------------------------------------------
// Module 14: Messages & Message Media
// -----------------------------------------------------------------------------

enum MessageType {
  TEXT
  MEDIA
  VOICE_NOTE
  DATE_INVITE
  SAFETY_PROMPT
  SYSTEM
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

enum MessageMediaType {
  IMAGE
  AUDIO_NOTE
  VIDEO
}

enum ModerationScanResult {
  SAFE
  NSFW_BLURRED
  REJECTED
}

model Message {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String                @map("conversation_id") @db.Uuid
  senderId         String                @map("sender_id") @db.Uuid
  messageType      MessageType           @default(TEXT) @map("message_type")
  content          String?               @db.Text
  replyToMessageId String?               @map("reply_to_message_id") @db.Uuid
  deliveryStatus   MessageDeliveryStatus @default(SENT) @map("delivery_status")
  sentAt           DateTime              @default(now()) @map("sent_at") @db.Timestamptz(6)
  editedAt         DateTime?             @map("edited_at") @db.Timestamptz(6)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?       @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]      @relation("MessageReplies")
  media        MessageMedia[]

  @@index([conversationId, sentAt(sort: Desc)])
  @@index([senderId, sentAt(sort: Desc)])
  @@map("messages")
}

model MessageMedia {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId            String               @map("message_id") @db.Uuid
  storageKey           String               @map("storage_key") @db.VarChar(255)
  mediaType            MessageMediaType     @map("media_type")
  fileSizeBytes        Int                  @map("file_size_bytes")
  durationSeconds      Int?                 @map("duration_seconds") @db.SmallInt
  blurhash             String?              @db.VarChar(64)
  isViewOnce           Boolean              @default(false) @map("is_view_once")
  viewedAt             DateTime?            @map("viewed_at") @db.Timestamptz(6)
  moderationScanResult ModerationScanResult @default(SAFE) @map("moderation_scan_result")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_media")
}

