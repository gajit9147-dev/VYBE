  UNDERAGE
}

enum ReportContextType {
  PROFILE
  MESSAGE
  PHOTO
  DATE_INCIDENT
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  ACTIONED
  DISMISSED
}

model UserReport {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId     String            @map("reporter_user_id") @db.Uuid
  reportedUserId     String            @map("reported_user_id") @db.Uuid
