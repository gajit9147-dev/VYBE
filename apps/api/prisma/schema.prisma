generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Core System Health
// -----------------------------------------------------------------------------

model DatabaseHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Module 1: Users & Authentication
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  PENDING_ONBOARDING
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  MEMBER
  COMMUNITY_CREATOR
  TESTER
}

enum IdentityProvider {
  APPLE
  GOOGLE
  PHONE_OTP
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber     String?    @unique @map("phone_number") @db.VarChar(20)
  email           String?    @unique @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(MEMBER)
  isVerified      Boolean    @default(false) @map("is_verified")
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  authCredential          AuthCredential?
  userIdentities          UserIdentity[]
  twoFactorAuth           TwoFactorAuth?
  sessions                UserSession[]
  devices                 UserDevice[]
  settings                UserSettings?
  consents                UserConsent[]
  profile                 Profile?
  discoveryPreferences    DiscoveryPreference?
  compatibilityAnswers    CompatibilityAnswer[]
  interactionsGiven       ProfileInteraction[]     @relation("ActorInteractions")
  interactionsReceived    ProfileInteraction[]     @relation("TargetInteractions")
  matchesAsUser1          Match[]                  @relation("User1Matches")
  matchesAsUser2          Match[]                  @relation("User2Matches")
  matchesClosed           Match[]                  @relation("ClosedMatches")
  conversationsAsUser1    Conversation[]           @relation("User1Conversations")
  conversationsAsUser2    Conversation[]           @relation("User2Conversations")
  messagesSent            Message[]
  notifications           Notification[]
  locationPrivacySettings LocationPrivacySetting?
  locationEvents          LocationEvent[]
  crossedPathsAsUser1     CrossedPath[]            @relation("User1CrossedPaths")
  crossedPathsAsUser2     CrossedPath[]            @relation("User2CrossedPaths")
  liveLocationShares      LiveLocationShare[]
  blocksGiven             UserBlock[]              @relation("BlockerBlocks")
  blocksReceived          UserBlock[]              @relation("BlockedBlocks")
  reportsFiled            UserReport[]             @relation("ReporterReports")
  reportsReceived         UserReport[]             @relation("ReportedReports")
  moderationCases         ModerationCase[]
  moderationActions       ModerationAction[]
  verifications           UserVerification[]
  safetyCheckins          SafetyCheckin[]
  trustedContacts         TrustedContact[]
  datePlansCreated        DatePlan[]
  emergencyEvents         EmergencyEvent[]
  subscriptions           UserSubscription[]
  paymentTransactions     PaymentTransaction[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerificationTokens PhoneVerificationToken[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model AuthCredential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordAlgo      String    @default("argon2id") @map("password_algo") @db.VarChar(32)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model UserIdentity {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  provider            IdentityProvider
  providerSubject     String           @map("provider_subject") @db.VarChar(255)
  providerEmail       String?          @map("provider_email") @db.VarChar(255)
  lastAuthenticatedAt DateTime         @default(now()) @map("last_authenticated_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model TwoFactorAuth {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  totpSecretEncrypted String?   @map("totp_secret_encrypted") @db.Text
  recoveryCodesHash   String[]  @default([]) @map("recovery_codes_hash")
  isEnabled           Boolean   @default(false) @map("is_enabled")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PhoneVerificationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phoneNumber String    @map("phone_number") @db.VarChar(20)
  otpHash     String    @map("otp_hash") @db.VarChar(64)
  attempts    Int       @default(0) @db.SmallInt
  maxAttempts Int       @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([phoneNumber, expiresAt])
  @@map("phone_verification_tokens")
}

// -----------------------------------------------------------------------------
// Module 2: Sessions & Devices
// -----------------------------------------------------------------------------

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(64)
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(128)
  ipHash            String    @map("ip_hash") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.Text
  isRevoked         Boolean   @default(false) @map("is_revoked")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  deviceId     String         @map("device_id") @db.VarChar(128)
  platform     DevicePlatform
  pushToken    String?        @map("push_token") @db.Text
  appVersion   String         @map("app_version") @db.VarChar(32)
  osVersion    String?        @map("os_version") @db.VarChar(32)
  isTrusted    Boolean        @default(false) @map("is_trusted")
  lastActiveAt DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([pushToken])
  @@map("user_devices")
}

// -----------------------------------------------------------------------------
// Module 3: User Settings & Consents
// -----------------------------------------------------------------------------

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  PRECISE_LOCATION
  BIOMETRIC_VERIFICATION
  DATA_PROCESSING
}

model UserSettings {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @unique @map("user_id") @db.Uuid
  isDiscoveryPaused Boolean         @default(false) @map("is_discovery_paused")
  isGhostMode       Boolean         @default(false) @map("is_ghost_mode")
  notifyNewMatches  Boolean         @default(true) @map("notify_new_matches")
  notifyMessages    Boolean         @default(true) @map("notify_messages")
  notifyDateSafety  Boolean         @default(true) @map("notify_date_safety")
  notifyMarketing   Boolean         @default(false) @map("notify_marketing")
  theme             ThemePreference @default(DARK)
  language          String          @default("en-US") @db.VarChar(10)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserConsent {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  consentType   ConsentType @map("consent_type")
  policyVersion String      @map("policy_version") @db.VarChar(24)
  isGranted     Boolean     @map("is_granted")
  ipHash        String      @map("ip_hash") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.Text
  grantedAt     DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, grantedAt(sort: Desc)])
  @@map("user_consents")
}

// -----------------------------------------------------------------------------
// Module 4: Profiles
// -----------------------------------------------------------------------------

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  GENDERQUEER
  OTHER
}

enum DrinkingFrequency {
  NEVER
  SOCIALLY
  REGULARLY
  SOBER
}

enum SmokingFrequency {
  NEVER
  SOCIALLY
  REGULARLY
}

enum ExerciseFrequency {
  DAILY
  OFTEN
  SOMETIMES
  RARELY
}

model Profile {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  firstName       String             @map("first_name") @db.VarChar(50)
  birthDate       DateTime           @map("birth_date") @db.Date
  gender          Gender
  pronouns        String?            @db.VarChar(32)
  bio             String?            @db.Text
  heightCm        Int?               @map("height_cm") @db.SmallInt
  occupation      String?            @db.VarChar(100)
  company         String?            @db.VarChar(100)
  education       String?            @db.VarChar(100)
  drinking        DrinkingFrequency?
  smoking         SmokingFrequency?
  exercise        ExerciseFrequency?
  starSign        String?            @map("star_sign") @db.VarChar(20)
  languages       String[]           @default([])
  completionScore Int                @default(0) @map("completion_score") @db.SmallInt
  isIncognito     Boolean            @default(false) @map("is_incognito")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos              ProfilePhoto[]
  prompts             ProfilePrompt[]
  interests           ProfileInterest[]
  relationshipIntents ProfileRelationshipIntent[]

  @@index([gender])
  @@index([birthDate])
  @@index([deletedAt])
  @@map("profiles")
}

// -----------------------------------------------------------------------------
// Module 5: Profile Photos
// -----------------------------------------------------------------------------

enum ModerationStatus {
  APPROVED
  PENDING
  REJECTED
  FLAGGED
}

model ProfilePhoto {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String           @map("profile_id") @db.Uuid
  storageKey       String           @map("storage_key") @db.VarChar(255)
  cdnUrl           String           @map("cdn_url") @db.VarChar(512)
  displayOrder     Int              @default(0) @map("display_order") @db.SmallInt
  isPrimary        Boolean          @default(false) @map("is_primary")
  blurhash         String?          @db.VarChar(64)
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  width            Int
  height           Int
  fileSizeBytes    Int              @map("file_size_bytes")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, displayOrder])
  @@index([moderationStatus])
  @@map("profile_photos")
}

// -----------------------------------------------------------------------------
// Module 6: Profile Prompts
// -----------------------------------------------------------------------------

enum PromptCategory {
  VALUES
  DATE_IDEAS
  HUMOR
  LIFESTYLE
}

model PromptTemplate {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     PromptCategory
  question     String         @db.VarChar(255)
  isActive     Boolean        @default(true) @map("is_active")
  displayOrder Int            @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  profilePrompts ProfilePrompt[]

  @@index([isActive, category])
  @@map("prompt_templates")
}

model ProfilePrompt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String   @map("profile_id") @db.Uuid
  templateId       String   @map("template_id") @db.Uuid
  answerText       String   @map("answer_text") @db.Text
  audioStorageKey  String?  @map("audio_storage_key") @db.VarChar(255)
  audioDurationSec Int?     @map("audio_duration_sec") @db.SmallInt
  displayOrder     Int      @default(0) @map("display_order") @db.SmallInt
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile  Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  template PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([profileId, templateId])
  @@index([profileId, displayOrder])
  @@map("profile_prompts")
}

// -----------------------------------------------------------------------------
// Module 7: Interests
// -----------------------------------------------------------------------------

model InterestCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(64)
  iconKey   String   @map("icon_key") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  interests Interest[]

  @@map("interest_categories")
}

model Interest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String   @db.VarChar(64)
  slug       String   @unique @db.VarChar(64)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category         InterestCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  profileInterests ProfileInterest[]

  @@index([slug])
  @@map("interests")
}

model ProfileInterest {
  profileId  String   @map("profile_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  rank       Int      @default(0) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId, profileId])
  @@map("profile_interests")
}

// -----------------------------------------------------------------------------
// Module 8: Relationship Intents
// -----------------------------------------------------------------------------

model RelationshipIntent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(32)
  label       String   @db.VarChar(64)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profileIntents ProfileRelationshipIntent[]

  @@map("relationship_intents")
}

model ProfileRelationshipIntent {
  profileId           String   @map("profile_id") @db.Uuid
  intentId            String   @map("intent_id") @db.Uuid
  isPrimary           Boolean  @default(true) @map("is_primary")
  customClarification String?  @map("custom_clarification") @db.VarChar(150)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  intent  RelationshipIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@id([profileId, intentId])
  @@map("profile_relationship_intents")
}

// -----------------------------------------------------------------------------
// Module 9: Discovery Preferences
// -----------------------------------------------------------------------------

model DiscoveryPreference {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  minAge                Int      @default(18) @map("min_age") @db.SmallInt
  maxAge                Int      @default(45) @map("max_age") @db.SmallInt
  isAgeDealbreaker      Boolean  @default(true) @map("is_age_dealbreaker")
  maxDistanceKm         Int      @default(50) @map("max_distance_km") @db.SmallInt
  isDistanceDealbreaker Boolean  @default(false) @map("is_distance_dealbreaker")
  interestedInGenders   Gender[] @default([WOMAN, MAN, NON_BINARY]) @map("interested_in_genders")
  relationshipIntentIds String[] @default([]) @map("relationship_intent_ids")
  isIntentDealbreaker   Boolean  @default(false) @map("is_intent_dealbreaker")
  verifiedProfilesOnly  Boolean  @default(false) @map("verified_profiles_only")
  hasBioOnly            Boolean  @default(false) @map("has_bio_only")
  minHeightCm           Int?     @map("min_height_cm") @db.SmallInt
  maxHeightCm           Int?     @map("max_height_cm") @db.SmallInt
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discovery_preferences")
}

// -----------------------------------------------------------------------------
// Module 10: Questions & Answers (Compatibility Dimensions)
// -----------------------------------------------------------------------------

enum CompatibilityDimension {
  COMMUNICATION
  VALUES
  LIFESTYLE
  ROMANCE
  FINANCIAL
}

enum QuestionImportance {
  IRRELEVANT
  SOMEWHAT
  VERY
  DEALBREAKER
}

model CompatibilityQuestion {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dimension    CompatibilityDimension
  questionText String                 @map("question_text") @db.Text
  options      Json                   @db.JsonB
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  answers CompatibilityAnswer[]

  @@index([dimension, isActive])
  @@map("compatibility_questions")
}

model CompatibilityAnswer {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  questionId               String             @map("question_id") @db.Uuid
  userAnswer               String             @map("user_answer") @db.VarChar(32)
  acceptablePartnerAnswers String[]           @map("acceptable_partner_answers")
  importance               QuestionImportance @default(SOMEWHAT)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question CompatibilityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, questionId])
  @@map("compatibility_answers")
}

// -----------------------------------------------------------------------------
// Module 11: Likes & Passes
// -----------------------------------------------------------------------------

enum InteractionAction {
  LIKE
  PASS
  SUPER_LIKE
}

enum TargetElementType {
  PHOTO
  PROMPT
  BIO
  PROFILE
}

model ProfileInteraction {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId       String             @map("actor_user_id") @db.Uuid
  targetUserId      String             @map("target_user_id") @db.Uuid
  action            InteractionAction
  targetElementType TargetElementType? @map("target_element_type")
  targetElementId   String?            @map("target_element_id") @db.Uuid
  comment           String?            @db.Text
  isConsumedByMatch Boolean            @default(false) @map("is_consumed_by_match")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  User @relation("ActorInteractions", fields: [actorUserId], references: [id], onDelete: Cascade)
  target User @relation("TargetInteractions", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, targetUserId])
  @@index([targetUserId, action, createdAt(sort: Desc)])
  @@index([actorUserId, action, createdAt(sort: Desc)])
  @@map("profile_interactions")
}

// -----------------------------------------------------------------------------
// Module 12: Matches & Match Reasons
// -----------------------------------------------------------------------------

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
  EXPIRED
}

model Match {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id           String      @map("user1_id") @db.Uuid
  user2Id           String      @map("user2_id") @db.Uuid
  status            MatchStatus @default(ACTIVE)
  matchedAt         DateTime    @default(now()) @map("matched_at") @db.Timestamptz(6)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)
  closedByUserId    String?     @map("closed_by_user_id") @db.Uuid
  unmatchReasonCode String?     @map("unmatch_reason_code") @db.VarChar(48)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user1    User  @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User  @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  closedBy User? @relation("ClosedMatches", fields: [closedByUserId], references: [id], onDelete: SetNull)

  matchReason  MatchReason?
  conversation Conversation?
  datePlans    DatePlan[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, status, matchedAt(sort: Desc)])
  @@index([user2Id, status, matchedAt(sort: Desc)])
  @@map("matches")
}

