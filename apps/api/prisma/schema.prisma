}

model AdminRolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  adminUserId       String   @map("admin_user_id") @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  assignedByAdminId String   @map("assigned_by_admin_id") @db.Uuid
  assignedAt        DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  adminUser  AdminUser @relation("AdminUserAssigned", fields: [adminUserId], references: [id], onDelete: Cascade)
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy AdminUser @relation("AdminUserAssigner", fields: [assignedByAdminId], references: [id], onDelete: Restrict)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

// -----------------------------------------------------------------------------
// Module 29: Admin Access Requests
// -----------------------------------------------------------------------------

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model AdminAccessRequest {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId       String              @map("admin_user_id") @db.Uuid
  permissionKey     String              @map("permission_key") @db.VarChar(64)
  targetUserId      String?             @map("target_user_id") @db.Uuid
  justification     String              @db.Text
  status            AccessRequestStatus @default(PENDING)
  approvedByAdminId String?             @map("approved_by_admin_id") @db.Uuid
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUser  AdminUser  @relation("AdminRequester", fields: [adminUserId], references: [id], onDelete: Cascade)
  approvedBy AdminUser? @relation("AdminApprover", fields: [approvedByAdminId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("admin_access_requests")
}

// -----------------------------------------------------------------------------
// Module 30: Audit Logs
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId    String   @map("admin_user_id") @db.Uuid
  action         String   @db.VarChar(64)
  resourceType   String   @map("resource_type") @db.VarChar(32)
  resourceId     String   @map("resource_id") @db.VarChar(128)
  reasonProvided String   @map("reason_provided") @db.Text
  ipAddress      String   @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  diffPayload    Json?    @map("diff_payload") @db.JsonB
  timestamp      DateTime @default(now()) @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, timestamp(sort: Desc)])
  @@index([adminUserId, timestamp(sort: Desc)])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Module 31: Subscriptions, Plans & Payments
// -----------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentGateway {
  APPLE_IAP
  GOOGLE_PLAY
  STRIPE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model SubscriptionPlan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String          @unique @db.VarChar(32)
  name            String          @db.VarChar(64)
  billingInterval BillingInterval @map("billing_interval")
  priceCents      Int             @map("price_cents")
  currency        String          @default("USD") @db.VarChar(3)
  features        Json            @default("{}") @db.JsonB
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  paymentGateway         PaymentGateway     @map("payment_gateway")
  externalSubscriptionId String             @map("external_subscription_id") @db.VarChar(128)
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(6)
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@unique([paymentGateway, externalSubscriptionId])
  @@index([userId, status, currentPeriodEnd(sort: Desc)])
  @@map("user_subscriptions")
}

model PaymentTransaction {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  subscriptionId        String?       @map("subscription_id") @db.Uuid
  externalTransactionId String        @unique @map("external_transaction_id") @db.VarChar(128)
  amountCents           Int           @map("amount_cents")
  currency              String        @default("USD") @db.VarChar(3)
  status                PaymentStatus
  rawReceiptUrl         String?       @map("raw_receipt_url") @db.VarChar(512)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("payment_transactions")
}

// -----------------------------------------------------------------------------
// Module 32: Feature Flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String   @unique @db.VarChar(64)
  description       String   @db.Text
  isGloballyEnabled Boolean  @default(false) @map("is_globally_enabled")
  rolloutPercentage Int      @default(0) @map("rollout_percentage") @db.SmallInt
  targetingRules    Json     @default("{}") @map("targeting_rules") @db.JsonB
  updatedByAdminId  String   @map("updated_by_admin_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy AdminUser @relation(fields: [updatedByAdminId], references: [id], onDelete: Restrict)

  @@map("feature_flags")
}

// -----------------------------------------------------------------------------
// Module 33: Analytics Events
// -----------------------------------------------------------------------------

model AnalyticsEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anonymousUserId String         @map("anonymous_user_id") @db.VarChar(64)
  eventName       String         @map("event_name") @db.VarChar(64)
  eventProperties Json           @default("{}") @map("event_properties") @db.JsonB
  appVersion      String         @map("app_version") @db.VarChar(32)
  platform        DevicePlatform
  clientTimestamp DateTime       @map("client_timestamp") @db.Timestamptz(6)
  serverTimestamp DateTime       @default(now()) @map("server_timestamp") @db.Timestamptz(6)

  @@index([eventName, serverTimestamp(sort: Desc)])
  @@map("analytics_events")
}
