# Local development settings only. Do not put secrets in this file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Supply local PostgreSQL credentials through your environment; do not commit a real value.
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@localhost:5432/DATABASE_NAME?schema=public

# Redis Configuration (Used for distributed rate limiting & temporary OTP state)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Phone Verification & OTP Settings
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_RESEND_COOLDOWN_SECONDS=60

# SMS Provider Abstraction ("memory" for local dev/testing, "twilio" for production)
SMS_PROVIDER=memory
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
